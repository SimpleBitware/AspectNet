<Project>
    <UsingTask
            TaskName="SimpleBitware.AspectNet.Build.AspectNetWeaverTask"
            AssemblyFile="$(MSBuildThisFileDirectory)..\tasks\SimpleBitware.AspectNet.dll" />

    <Target Name="AspectNetWeavingTarget" AfterTargets="CoreCompile" Condition="'$(SkipAspectNetWeaving)' != 'true'">
        <SimpleBitware.AspectNet.Build.AspectNetWeaverTask
                AssemblyPath="@(IntermediateAssembly)"
                References="@(ReferencePath)"
                Debug="False" />
        <Touch Files="@(IntermediateAssembly)" />
    </Target>
</Project>
