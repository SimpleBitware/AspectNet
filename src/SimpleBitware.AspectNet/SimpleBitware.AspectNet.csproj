<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <NoWarn>NU5128</NoWarn>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <PropertyGroup>
        <!-- NuGet package info -->
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>SimpleBitware.AspectNet</PackageId>
        <Version>1.0.0</Version>
        <Authors>Lucian</Authors>
        <Description>AspectNet incremental source generator</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>source-generator;roslyn;aop;weaver</PackageTags>
        <!-- Strongly recommended for analyzers/generators -->
        <EnforceExtendedAnalyzerRules>false</EnforceExtendedAnalyzerRules>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath=""/>
    </ItemGroup>

    <ItemGroup>
        <!-- Roslyn APIs for incremental generators -->
        <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.0.0"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
    </ItemGroup>

    <!-- Non refered projects which will be included in the nuget package -->
    <PropertyGroup>
        <AnalyzersProjectName>SimpleBitware.AspectNet.Analyzers</AnalyzersProjectName>
        <AnalyzersBinFolder>../$(AnalyzersProjectName)/bin/$(Configuration)/$(TargetFramework)</AnalyzersBinFolder>
        <CodeFixesProjectName>SimpleBitware.AspectNet.CodeFixes</CodeFixesProjectName>
        <CodeFixesBinFolder>../$(CodeFixesProjectName)/bin/$(Configuration)/$(TargetFramework)</CodeFixesBinFolder>
        <AbstractionsProjectName>SimpleBitware.AspectNet.Abstractions</AbstractionsProjectName>
        <AbstractionsBinFolder>../$(AbstractionsProjectName)/bin/$(Configuration)/$(TargetFramework)</AbstractionsBinFolder>
    </PropertyGroup>

    <!-- Build ordering only (no assembly reference) -->
    <ItemGroup>
        <ProjectReference Include="..\$(AnalyzersProjectName)\$(AnalyzersProjectName).csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"/>
        <ProjectReference Include="..\$(CodeFixesProjectName)\$(CodeFixesProjectName).csproj"
                          PrivateAssets="all"/>
        <ProjectReference Include="..\$(AbstractionsProjectName)\$(AbstractionsProjectName).csproj"
                          PrivateAssets="all"/>
    </ItemGroup>

    <!-- Include generator DLL in the NuGet package -->
    <ItemGroup>
        <None Include="$(OutputPath)$(AssemblyName).dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="false"/>
    </ItemGroup>

    <!-- Include analyzers assemblies (without referencing them) -->
    <ItemGroup>
        <None Include="$(AnalyzersBinFolder)\$(AnalyzersProjectName).dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              IsAnalyzer="true"
              Visible="false"/>
        <None Include="$(CodeFixesBinFolder)\$(CodeFixesProjectName).dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              IsAnalyzer="true"
              Visible="false"/>
        <None Include="$(AbstractionsBinFolder)\$(AbstractionsProjectName).dll"
              Pack="true"
              PackagePath="lib/netstandard2.0" 
              Visible="False"/>
    </ItemGroup>

</Project>
