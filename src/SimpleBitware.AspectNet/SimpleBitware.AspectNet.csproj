<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>SimpleBitware.AspectNet</PackageId>
        <Description>AspectNet enables aspect oriented programming</Description>
        <Authors>Lucian Bornaz</Authors>
        <Company>Simple Bitware</Company>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/SimpleBitware/AspectNet/tree/main/src/SimpleBitware.AspectNet</PackageProjectUrl>
        <RepositoryUrl>https://github.com/SimpleBitware/AspectNet</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>logo.png</PackageIcon>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <NoPackageAnalysis>true</NoPackageAnalysis>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <MinVerTagPrefix>v</MinVerTagPrefix>
    </PropertyGroup>

    <ItemGroup Condition="'$(Pack)' != 'true'">
        <ProjectReference Include="..\SimpleBitware.AspectNet.Cecil\SimpleBitware.AspectNet.Cecil.csproj"/>
    </ItemGroup>
    <ItemGroup Condition="'$(Pack)' == 'true'">
        <PackageReference Include="SimpleBitware.AspectNet.Cecil" Version="$(Version)"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.4.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.7"/>
        <PackageReference Include="MinVer" Version="7.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md"
              Pack="true"
              PackagePath=""
              Visible="false"/>
        <None Include="..\..\resources\logo.png"
              Pack="true"
              PackagePath=""
              Visible="false"/>
        <None Include="Package\build\SimpleBitware.AspectNet.targets"
              Pack="true"
              PackagePath="build"/>
        <None Include="Package\build\SimpleBitware.AspectNet.props"
              Pack="true"
              PackagePath="build"/>
    </ItemGroup>

    <Target Name="AddTaskAssembliesToPack" AfterTargets="Build" BeforeTargets="GenerateNuspec">
        <ItemGroup>
            <_CandidateDirs Include="$(TargetDir)"/>
            <_TaskAssemblies Include="$(TargetDir)*.dll" Condition="Exists('$(TargetDir)')"/>
        </ItemGroup>
        <ItemGroup>
            <None Remove="@(_TaskAssemblies)"/>
            <Content Remove="@(_TaskAssemblies)"/>
        </ItemGroup>
        <ItemGroup>
            <Content Include="@(_TaskAssemblies)" Condition="Exists('%(Identity)')">
                <Pack>true</Pack>
                <PackagePath>tasks/$(TargetFramework)/</PackagePath>
                <Link>tasks/$(TargetFramework)/%(Filename)%(Extension)</Link>
            </Content>
        </ItemGroup>
    </Target>

</Project>
