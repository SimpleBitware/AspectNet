<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <NoWarn>NU5128</NoWarn>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <PropertyGroup>
        <!-- NuGet package info -->
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>AspectNet.Generator</PackageId>
        <Version>1.0.0</Version>
        <Authors>Lucian</Authors>
        <Description>AspectNet incremental source generator</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>source-generator;roslyn;aop;weaver</PackageTags>
<!--        <IncludeBuildOutput>false</IncludeBuildOutput>-->
        <!-- Strongly recommended for analyzers/generators -->
        <EnforceExtendedAnalyzerRules>false</EnforceExtendedAnalyzerRules>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="" />
    </ItemGroup>
    
    <ItemGroup>
        <!-- Roslyn APIs for incremental generators -->
        <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.0.0"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)SimpleBitware.AspectNet.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>

</Project>
