<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>SimpleBitware.AspectNet</PackageId>
        <Version>1.0.0</Version>
        <Authors>Lucian Bornaz</Authors>
        <Company>Simple Bitware</Company>
        <Description>Aspect-Oriented Programming for .NET with Roslyn Source Generators.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/SimpleBitware/Aop</PackageProjectUrl>
        <RepositoryUrl>https://github.com/SimpleBitware/Aop</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <BuildOutputTargetFolder />
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <BuildProjectReferences>true</BuildProjectReferences>
        <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
        <IsPackable>true</IsPackable>
        <MinVerTagPrefix>v</MinVerTagPrefix>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MinVer" Version="6.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    
    <ItemGroup>
        <!-- Attributes library -->
        <ProjectReference Include="..\SimpleBitware.AspectNet.Attributes\SimpleBitware.AspectNet.Attributes.csproj" PrivateAssets="all" >
            <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
            <IncludeAssets>SimpleBitware.AspectNet.Attributes.dll</IncludeAssets>
        </ProjectReference>
        
        <!-- Runtime library -->
        <ProjectReference Include="..\SimpleBitware.AspectNet.Runtime\SimpleBitware.AspectNet.Runtime.csproj" PrivateAssets="compile" />
        
        <!-- Analyzer (source generator) -->
        <ProjectReference Include="..\SimpleBitware.AspectNet.Generator\SimpleBitware.AspectNet.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
        
        <!-- Ship design-time stubs to consumers -->
        <None Include="contentFiles\*.cs" Pack="true" PackagePath="contentFiles/cs/any" BuildAction="Compile" CopyToOutput="Never" />
    </ItemGroup>

