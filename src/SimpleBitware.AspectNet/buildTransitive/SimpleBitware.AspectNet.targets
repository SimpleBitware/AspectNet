<Project>

    <!-- Load the weaver task -->
    <UsingTask TaskName="SimpleBitware.AspectNet.SourceWeaver"
               AssemblyFile="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\tools\$(AspectNetWeaverTfm)\SimpleBitware.AspectNet.dll'))" />

    <PropertyGroup>
        <AspectNetOut Condition="'$(AspectNetOut)'=='' and '$(IntermediateOutputPath)'!=''">$(IntermediateOutputPath)$(AspectNetFolderName)/</AspectNetOut>
        <AspectNetOut Condition="'$(AspectNetOut)'==''">$(MSBuildProjectDirectory)/obj/$(AspectNetFolderName)/</AspectNetOut>
    </PropertyGroup>

    <!-- Run the weaver -->
    <Target Name="SimpleBitware_AspectNet_RunWeaver"
            Condition="'$(AspectNetWeaverEnabled)'=='true'"
            AfterTargets="ResolveReferences"
            BeforeTargets="PrepareForBuild">

        <MakeDir Directories="$(AspectNetOut)" />
        <SourceWeaver ProjectDir="$(MSBuildProjectDirectory)" OutDir="$(AspectNetOut)" />
    </Target>

    <!-- Rewrite Compile items -->
    <Target Name="SimpleBitware_AspectNet_ApplyRewrites"
            Condition="'$(AspectNetWeaverEnabled)'=='true'"
            AfterTargets="SimpleBitware_AspectNet_RunWeaver"
            BeforeTargets="PrepareForBuild">

        <ItemGroup>
            <!-- Load generated files -->
            <AspectNetGenerated Include="$(AspectNetOut)**\*.cs" />

            <!-- Snapshot original compile items (now WITHOUT generated files) -->
            <_OriginalCompile Include="@(Compile)" />

            <!-- Match originals by filename -->
            <_CompileToRemove Include="@(_OriginalCompile)"  />
        </ItemGroup>

        <ItemGroup>
            <!-- Remove originals -->
            <Compile Remove="@(_CompileToRemove)" />

            <!-- Add generated files (hidden from Rider) -->
            <Compile Include="@(AspectNetGenerated)" Visible="false" />
        </ItemGroup>

    </Target>

</Project>
