<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <NoWarn>NU5128</NoWarn>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>
    <PropertyGroup>
        <PackageId>SimpleBitware.AspectNet</PackageId>
        <Version>1.0.0</Version>
        <Authors>Lucian Bornaz</Authors>
        <Company>Simple Bitware</Company>
        <Description>Aspect-Oriented Programming for .NET using Roslyn Source Code Weaver.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/SimpleBitware/AspectNet</PackageProjectUrl>
        <RepositoryUrl>https://github.com/SimpleBitware/AspectNet</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IsPackable>true</IsPackable>
        <MinVerTagPrefix>v</MinVerTagPrefix>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MinVer" Version="6.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Framework" Version="18.0.2" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.0.2" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Include="build\SimpleBitware.AspectNet.props" Pack="true" PackagePath="build/SimpleBitware.AspectNet.props" />
        <None Include="build\SimpleBitware.AspectNet.targets" Pack="true" PackagePath="build/SimpleBitware.AspectNet.targets" />
        <None Include="..\..\README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <!-- Build ordering only (no assembly reference) -->
    <ItemGroup>
        <ProjectReference Include="..\SimpleBitware.AspectNet.Engine\SimpleBitware.AspectNet.Engine.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
        <ProjectReference Include="..\SimpleBitware.AspectNet.DependencyInjection\SimpleBitware.AspectNet.DependencyInjection.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>

    <!-- Build task assembly -->
    <ItemGroup>
        <None Include="$(OutputPath)$(TargetFileName)"
              Pack="true"
              PackagePath="tools/"
              Visible="false" />
    </ItemGroup>

    <!-- Engine + Roslyn deps (minimal curated set) -->
    <PropertyGroup>
        <EngineBinFolder>../SimpleBitware.AspectNet.Engine/bin/$(Configuration)/$(TargetFramework)</EngineBinFolder>
        <DependecyInjectionBinFolder>../SimpleBitware.AspectNet.DependencyInjection/bin/$(Configuration)/$(TargetFramework)</DependecyInjectionBinFolder>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(EngineBinFolder)/SimpleBitware.AspectNet.Engine.dll"
              Pack="true"
              PackagePath="tools/"
              Visible="false" />
        <None Include="$(DependecyInjectionBinFolder)/SimpleBitware.AspectNet.DependencyInjection.dll"
              Pack="true"
              PackagePath="tools/"
              Visible="false" />

        <None Include="$(EngineBinFolder)/Microsoft.CodeAnalysis*.dll"
              Pack="true"
              PackagePath="tools/"
              Visible="false" />

        <None Include="$(EngineBinFolder)/System.Collections.Immutable.dll"
              Pack="true"
              PackagePath="tools/"
              Visible="false" />

        <None Include="$(EngineBinFolder)/System.Reflection.Metadata.dll"
              Pack="true"
              PackagePath="tools/"
              Visible="false" />

        <None Include="$(EngineBinFolder)/System.Runtime.CompilerServices.Unsafe.dll"
              Pack="true"
              PackagePath="tools/"
              Visible="false" />
    </ItemGroup>

</Project>
