<Project>

    <!-- Load the weaver task -->
    <UsingTask TaskName="SimpleBitware.AspectNet.Build.SourceWeaver"
               AssemblyFile="$(MSBuildThisFileDirectory)..\tools\SimpleBitware.AspectNet.Build.dll" />

    <PropertyGroup>
        <GeneratedFilesOutputDirectory Condition="'$(GeneratedFilesOutputDirectory)'=='' and '$(IntermediateOutputPath)'!=''">$(IntermediateOutputPath)$(GeneratedFilesDirectoryName)/</GeneratedFilesOutputDirectory>
        <GeneratedFilesOutputDirectory Condition="'$(GeneratedFilesOutputDirectory)'==''">$(MSBuildProjectDirectory)/obj/$(GeneratedFilesDirectoryName)/</GeneratedFilesOutputDirectory>
    </PropertyGroup>

    <!-- Run the weaver -->
    <Target Name="SimpleBitware_AspectNet_RunWeaver"
            Condition="'$(AspectNetWeaverEnabled)'=='true'"
            AfterTargets="ResolveReferences"
            BeforeTargets="PrepareForBuild">

        <MakeDir Directories="$(GeneratedFilesOutputDirectory)" />
        <SourceWeaver ProjectDirectory="$(MSBuildProjectDirectory)" OutputDirectory="$(GeneratedFilesOutputDirectory)" DebugMode="$(DebugMode)"/>
    </Target>

    <!-- Rewrite Compile items -->
    <Target Name="SimpleBitware_AspectNet_ApplyRewrites"
            Condition="'$(AspectNetWeaverEnabled)'=='true'"
            AfterTargets="SimpleBitware_AspectNet_RunWeaver"
            BeforeTargets="PrepareForBuild">

        <ItemGroup>
            <!-- Load generated files -->
            <AspectNetGenerated Include="$(GeneratedFilesOutputDirectory)**\*.cs" />

            <!-- Snapshot original compile items (now WITHOUT generated files) -->
            <_OriginalCompile Include="@(Compile)" />

            <!-- Match originals by filename -->
            <_CompileToRemove Include="@(_OriginalCompile)"  />
        </ItemGroup>

        <ItemGroup>
            <!-- Remove originals -->
            <Compile Remove="@(_CompileToRemove)" />

            <!-- Add generated files (hidden from Rider) -->
            <Compile Include="@(AspectNetGenerated)" Visible="false" />
        </ItemGroup>

    </Target>

</Project>
